## This section is where custom domain / email / passwords are defined:
DNS_DOMAIN=<your-DNS-subdomain-here>

# Obtained via  'echo $(htpasswd -nbB admin 2FederateM0re) | sed -e s/\\$/\\$\\$/g'
### *** Paste output here *****
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$2y$$05$$GnwXDST1ayWsEni123495.kea2eZaxHAsOKyQcpBuTkfngJsSRL3S

# ENV VAR to provide Traefik with 
TRAEFIK_CERTIFICATESRESOLVERS_cloudflare_ACME_EMAIL=<your email here>
# TRAEFIK_CERTIFICATESRESOLVERS_cloudflare_ACME_caServer=https://acme-v02.api.letsencrypt.org/directory  #prod
TRAEFIK_CERTIFICATESRESOLVERS_cloudflare_ACME_caServer=https://acme-staging-v02.api.letsencrypt.org/directory  #staging
##### End Section
#
# "_PUBLIC_" = External facing DNS name, "_PRIVATE_" = Internal facing DNS name

# PF_ENGINE
PF_ENGINE_PRIVATE_HOSTNAME=pf.${DNS_DOMAIN}
PF_ENGINE_PUBLIC_HOSTNAME=pf.${DNS_DOMAIN}
PF_ENGINE_BASE_URL=pf.${DNS_DOMAIN}:443
PF_ENGINE_PUBLIC_PORT_HTTPS=443
PF_ENGINE_PRIVATE_PORT_HTTPS=9031
PF_ENGINE_BASE_URL=pf.${DNS_DOMAIN}:443

# PF Admin
PF_ADMIN_PUBLIC_BASEURL=https://pf-admin.${DNS_DOMAIN}
PF_RUN_PF_ADMIN_BASEURL=https://pf-admin.${DNS_DOMAIN}
PF_ADMIN_PUBLIC_HOSTNAME=pf-admin.${DNS_DOMAIN}
PF_RUN_PF_ADMIN_HOSTNAME=${PF_ADMIN_PUBLIC_HOSTNAME}
PF_ADMIN_PRIVATE_HOSTNAME=pingfederate-admin
PF_ADMIN_PUBLIC_PORT_HTTPS=443

# PA
PA_ENGINE_PUBLIC_HOSTNAME=pa.${DNS_DOMAIN}
PA_ADMIN_PUBLIC_HOSTNAME=pa-admin.${DNS_DOMAIN}
PA_ENGINE_PRIVATE_HOSTNAME=pingaccess
PA_ADMIN_PRIVATE_HOSTNAME=pingaccess

APP_PUBLIC_HOSTNAME=myapp.${DNS_DOMAIN}


# PD
PD_ENGINE_PUBLIC_HOSTNAME=pd.${DNS_DOMAIN}
PD_ENGINE_PRIVATE_HOSTNAME=pingdirectory
PF_ENGINE_BASE_URL=pf.${DNS_DOMAIN}

# for PF Access - not LDAPS
PD_ENGINE_PRIVATE_PORT_LDAP=1389

LDAP_PORT=1389
LDAPS_PORT=1636
HTTPS_PORT=1443